<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>EyeBossTrueEyeAllPlayers</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EyeBossTrueEyeAllPlayers.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TerrariaServer">
      <HintPath>$(MSBuildProjectDirectory)/TerrariaServer.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TerrariaServerDll" Condition="Exists('$(MSBuildProjectDirectory)/TerrariaServer.dll')">
      <HintPath>$(MSBuildProjectDirectory)/TerrariaServer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TShockAPI">
      <HintPath>$(MSBuildProjectDirectory)/TShockAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework" Condition="Exists('$(MSBuildProjectDirectory)/Microsoft.Xna.Framework.dll')">
      <HintPath>$(MSBuildProjectDirectory)/Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
