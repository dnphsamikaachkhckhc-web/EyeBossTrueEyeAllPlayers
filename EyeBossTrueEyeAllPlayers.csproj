<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>EyeBossTrueEyeAllPlayers</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="EyeBossTrueEyeAllPlayers.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="TerrariaServer">
      <HintPath>TerrariaServer.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TShockAPI">
      <HintPath>TShockAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework" Condition="Exists('Microsoft.Xna.Framework.dll')">
      <HintPath>Microsoft.Xna.Framework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Game" Condition="Exists('Microsoft.Xna.Framework.Game.dll')">
      <HintPath>Microsoft.Xna.Framework.Game.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Graphics" Condition="Exists('Microsoft.Xna.Framework.Graphics.dll')">
      <HintPath>Microsoft.Xna.Framework.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Microsoft.Xna.Framework.Xna" Condition="Exists('Microsoft.Xna.Framework.Xna.dll')">
      <HintPath>Microsoft.Xna.Framework.Xna.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
