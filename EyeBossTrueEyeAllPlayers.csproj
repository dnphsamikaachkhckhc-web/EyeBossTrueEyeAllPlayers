<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>EyeBossTrueEyeAllPlayers</AssemblyName>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TerrariaServer">
      <HintPath Condition="Exists('TerrariaServer.exe')">TerrariaServer.exe</HintPath>
      <HintPath Condition="Exists('terrariaserver.exe')">terrariaserver.exe</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TShockAPI">
      <HintPath Condition="Exists('TShockAPI.dll')">TShockAPI.dll</HintPath>
      <HintPath Condition="Exists('tshockapi.dll')">tshockapi.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="*.dll" Exclude="EyeBossTrueEyeAllPlayers.dll">
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
